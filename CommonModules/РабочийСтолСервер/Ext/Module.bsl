// Общий модуль: РабочийСтолСервер

Функция KPIВсегоЗарезервировано() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Остатки.РезервОстаток), 0) КАК Показатель
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Остатки() КАК Остатки";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Показатель;
	
КонецФункции

Функция KPIКвотыНаПределе() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Показатель
		|ИЗ
		|	(ВЫБРАТЬ
		|		Квоты.КоличествоОборот КАК ОстатокКвоты
		|	ИЗ
		|		РегистрНакопления.КвотыПартнеров.Обороты() КАК Квоты) КАК Т
		|ГДЕ
		|	Т.ОстатокКвоты < &Порог";
	Запрос.УстановитьПараметр("Порог", 100);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Показатель;
	
КонецФункции

Функция KPIПозицииДефицита() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Показатель
		|ИЗ
		|	(ВЫБРАТЬ
		|		Остатки.ФизическийОстатокОстаток - Остатки.РезервОстаток КАК СвободныйОстаток
		|	ИЗ
		|		РегистрНакопления.ТоварыНаСкладах.Остатки() КАК Остатки) КАК Т
		|ГДЕ
		|	Т.СвободныйОстаток <= 0";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Показатель;
	
КонецФункции

Функция KPIРезервовЗаНеделю() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Показатель
		|ИЗ
		|	Документ.РезервированиеТоваров КАК Документ
		|ГДЕ
		|	Документ.Дата >= &НачалоНедели
		|	И Документ.Проведен";
	Запрос.УстановитьПараметр("НачалоНедели", НачалоНедели(ТекущаяДата()));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Показатель;
	
КонецФункции