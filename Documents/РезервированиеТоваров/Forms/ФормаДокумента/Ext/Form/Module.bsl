
////////////////////////////////////////////////////////////////////////////////
// ФОРМА. Документ РезервированиеТоваров, модуль формы.
// Неоптимизированная версия для последующего рефакторинга.
//
// Реквизиты формы:
//   ВсеЦены, ВсеОстатки, ВсяНоменклатура - ТаблицаЗначений
//   ОстаткиКвот - ДинамическийСписок (параметр Партнер)
////////////////////////////////////////////////////////////////////////////////

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка) 
	
// ЗАМЕР: старт сценария "открытие"
	ЗамерНачалаОткрытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ЗапросЦен = Новый Запрос;
	ЗапросЦен.Текст = 
		"ВЫБРАТЬ
		|	ЦеныСрез.Номенклатура,
		|	ЦеныСрез.Цена
		|ИЗ
		|	РегистрСведений.Цены.СрезПоследних КАК ЦеныСрез";
	ВсеЦены.Загрузить(ЗапросЦен.Выполнить().Выгрузить());
	
	ЗапросОстатков = Новый Запрос;
	ЗапросОстатков.Текст = 
		"ВЫБРАТЬ
		|	Остатки.Склад,
		|	Остатки.Номенклатура,
		|	Остатки.ФизическийОстатокОстаток,
		|	Остатки.РезервОстаток
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Остатки КАК Остатки";
	ВсеОстатки.Загрузить(ЗапросОстатков.Выполнить().Выгрузить());
	
	ЗапросНоменклатуры = Новый Запрос;
	ЗапросНоменклатуры.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка,
		|	Номенклатура.Наименование
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	НЕ Номенклатура.ЭтоГруппа";
	ВсяНоменклатура.Загрузить(ЗапросНоменклатуры.Выполнить().Выгрузить());
	
	Для Каждого СтрокаНом Из ВсяНоменклатура Цикл
		Элементы.ТоварыНоменклатура.СписокВыбора.Добавить(СтрокаНом.Ссылка, СтрокаНом.Наименование);
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьЦеныИОстаткиНаСервере();
	
	ОстаткиКвот.Параметры.УстановитьЗначениеПараметра("Партнер", Объект.Партнер); 
		
	// ЗАМЕР: финиш сценария "открытие"
	Сообщить("ОТКРЫТИЕ: " + (ТекущаяУниверсальнаяДатаВМиллисекундах() - ЗамерНачалаОткрытия) + " мс");
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОбновитьЦеныИОстаткиНаСервере();
	Сообщить("ИЗМЕНЕНИЕ СТРОКИ: " + (ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) + " мс");

КонецПроцедуры

&НаКлиенте
Процедура СкладПриИзменении(Элемент)
	
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОбновитьЦеныИОстаткиНаСервере();
	Сообщить("СМЕНА СКЛАДА: " + (ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) + " мс");
	
КонецПроцедуры

&НаКлиенте
Процедура ПартнерПриИзменении(Элемент)
	
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОстаткиКвот.Параметры.УстановитьЗначениеПараметра("Партнер", Объект.Партнер);
	Сообщить("СМЕНА ПАРТНЕРА: " + (ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) + " мс");

	
КонецПроцедуры

&НаСервере
Процедура ОбновитьЦеныИОстаткиНаСервере()
	
	Для Каждого СтрокаТЧ Из Объект.Товары Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		
		ЗапросЦены = Новый Запрос;
		ЗапросЦены.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ЦеныСрез.Цена
			|ИЗ
			|	РегистрСведений.Цены.СрезПоследних(, Номенклатура = &Номенклатура) КАК ЦеныСрез";
		ЗапросЦены.УстановитьПараметр("Номенклатура", СтрокаТЧ.Номенклатура);
		
		ВыборкаЦены = ЗапросЦены.Выполнить().Выбрать();
		Если ВыборкаЦены.Следующий() Тогда
			СтрокаТЧ.Цена = ВыборкаЦены.Цена;
		КонецЕсли;
		
		
		ЗапросОстатка = Новый Запрос;
		ЗапросОстатка.Текст = 
			"ВЫБРАТЬ
			|	Остатки.ФизическийОстатокОстаток - Остатки.РезервОстаток КАК ДоступныйОстаток
			|ИЗ
			|	РегистрНакопления.ТоварыНаСкладах.Остатки(, Склад = &Склад И Номенклатура = &Номенклатура) КАК Остатки";
		ЗапросОстатка.УстановитьПараметр("Склад", Объект.Склад);
		ЗапросОстатка.УстановитьПараметр("Номенклатура", СтрокаТЧ.Номенклатура);
		
		ВыборкаОстатка = ЗапросОстатка.Выполнить().Выбрать();
		Если ВыборкаОстатка.Следующий() Тогда
			СтрокаТЧ.ДоступныйОстаток = ВыборкаОстатка.ДоступныйОстаток;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры


