#Область ОбрабочикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// ЗАМЕР: старт сценария "открытие"
	ЗамерНачалаОткрытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	// Грехи 1-3 удалены: никаких полных срезов, никаких выгрузок справочника,
	// никакой ручной набивки СписокВыбора - штатный выбор по типу поля быстрее.
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПерезаполнитьЦеныИОстатки();
	Сообщить("ОТКРЫТИЕ: " + (ТекущаяУниверсальнаяДатаВМиллисекундах() - ЗамерНачалаОткрытия) + " мс");
	
	ОстаткиКвот.Параметры.УстановитьЗначениеПараметра("Партнер", Объект.Партнер);
	
КонецПроцедуры
	
#КонецОбласти

#Область ОбрабочикиРеквизитов 

&НаКлиенте
Процедура СкладПриИзменении(Элемент)
	
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ПерезаполнитьЦеныИОстатки();
	Сообщить("СМЕНА СКЛАДА: " + (ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) + " мс");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТабЧастиТовары

 &НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ТекСтрока = Элементы.Товары.ТекущиеДанные;
	Если ТекСтрока = Неопределено Или Не ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
		Возврат;
	КонецЕсли;
	
	Данные = ТоварыНоменклатураПриИзменении_Сервер(ТекСтрока.Номенклатура, Объект.Склад, Объект.Партнер);
	
	ТекСтрока.Цена = Данные.Цена;
	ТекСтрока.ДоступныйОстаток = Данные.ДоступныйОстаток;
	
	ОбновитьВидимостьПредупреждения();
	
	Сообщить("ИЗМЕНЕНИЕ СТРОКИ: " + (ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) + " мс"); 
	
КонецПроцедуры

#КонецОбласти

#Область ВспомогательныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ПолучитьЦеныИОстаткиСписком(ЗНАЧ Номенклатуры, ЗНАЧ Склад, ЗНАЧ Партнер) Экспорт
	
	Результат = Новый Соответствие;
	
	Если Номенклатуры.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого Номенклатура Из Номенклатуры Цикл
		Результат.Вставить(Номенклатура, Новый Структура("Цена, ДоступныйОстаток", 0, 0));
	КонецЦикла;
	
	ЗапросЦен = Новый Запрос;
	ЗапросЦен.Текст = 
		"ВЫБРАТЬ
		|	ЦеныСрез.Номенклатура,
		|	ЦеныСрез.Цена
		|ИЗ
		|	РегистрСведений.Цены.СрезПоследних(, Номенклатура В (&Номенклатуры)) КАК ЦеныСрез";
	ЗапросЦен.УстановитьПараметр("Номенклатуры", Номенклатуры);
	
	Выборка = ЗапросЦен.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Получить(Выборка.Номенклатура).Цена = Выборка.Цена;
	КонецЦикла;
	
	ЗапросОстатков = Новый Запрос;
	ЗапросОстатков.Текст = 
		"ВЫБРАТЬ
		|	Остатки.Номенклатура,
		|	Остатки.ФизическийОстатокОстаток - Остатки.РезервОстаток КАК ДоступныйОстаток
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Остатки(, Склад = &Склад И Номенклатура В (&Номенклатуры)) КАК Остатки";
	ЗапросОстатков.УстановитьПараметр("Склад", Склад);
	ЗапросОстатков.УстановитьПараметр("Номенклатуры", Номенклатуры);
	
	Выборка = ЗапросОстатков.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Получить(Выборка.Номенклатура).ДоступныйОстаток = Выборка.ДоступныйОстаток;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции 

&НаСервереБезКонтекста
Функция ТоварыНоменклатураПриИзменении_Сервер(ЗНАЧ Номенклатура, ЗНАЧ Склад, ЗНАЧ Партнер)
	Возврат ЦеныОстатки_Сервер_ПовторноеИспользование.ПолучитьЦенуИОстаток(Номенклатура, Склад, Партнер);
КонецФункции

&НаКлиенте
Процедура ПерезаполнитьЦеныИОстатки()
	
	СписокНом = Новый Массив;
	Для Каждого СтрокаТЧ Из Объект.Товары Цикл
		Если ЗначениеЗаполнено(СтрокаТЧ.Номенклатура)
			И СписокНом.Найти(СтрокаТЧ.Номенклатура) = Неопределено Тогда
			СписокНом.Добавить(СтрокаТЧ.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	
	Если СписокНом.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Данные = ПолучитьЦеныИОстаткиСписком(СписокНом, Объект.Склад, Объект.Партнер);
	
	Для Каждого СтрокаТЧ Из Объект.Товары Цикл
		СтрокаДанных = Данные.Получить(СтрокаТЧ.Номенклатура);
		Если СтрокаДанных <> Неопределено Тогда
			СтрокаТЧ.Цена = СтрокаДанных.Цена;
			СтрокаТЧ.ДоступныйОстаток = СтрокаДанных.ДоступныйОстаток;
		КонецЕсли;
	КонецЦикла;
	
	ОбновитьВидимостьПредупреждения();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимостьПредупреждения()
	
	ЕстьДефицит = Ложь;
	Для Каждого СтрокаТЧ Из Объект.Товары Цикл
		Если ЗначениеЗаполнено(СтрокаТЧ.Номенклатура)
			И СтрокаТЧ.Количество > СтрокаТЧ.ДоступныйОстаток Тогда
			ЕстьДефицит = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Элементы.НадписьДефицит.Видимость = ЕстьДефицит;
	
КонецПроцедуры 

#КонецОбласти